{
  "name": "tree-sitter-bloblang",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Bloblang, the data mapping language used by Benthos/Redpanda Connect",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teyfix/tree-sitter-bloblang.git.git"
  },
  "funding": "",
  "license": "MIT",
  "author": {
    "name": "Halil Teyfik Dolmaci",
    "email": "hlltvfk@gmail.com",
    "url": "https://github.com/teyfix"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "bloblang"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "lefthook": "^2.1.8",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
